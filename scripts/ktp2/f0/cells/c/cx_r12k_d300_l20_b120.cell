# [KTP2-F0 · Ajan C] ÜRETİLDİ — scripts/ktp2/f0/c/gen_cells.py (elle düzenlemeyin).
# öncelik=2  demet=120 ms  kayıp=%20  gecikme=d300  hız=r12k  payload=37 B  çerçeve=168  ısınma=16
# (sabit RS kolu yok)
# tahmini süre: 3 kol × 10 tekrar × ~30 s = 0.25 koşu-saati
# rx-log: AÇIK (İSTEK-C1)
CELL=cx_r12k_d300_l20_b120
FWD="delay 300ms 60ms distribution normal loss 20% rate 100kbit"
REV="$FWD"
REPS=10
ARMS="uyar64_taban pol_taban uyar_taban"
BUDGET_S=120
CAPTURE=0
SETTLE_S=1
ARM_uyar64_taban_SRV="@BIN_TABAN@ serve --bind @SRV@ --transport kama-product --payload 37 --fec-profile 2 --fec-mode adaptive --rx-log @D@/rx.jsonl"
ARM_uyar64_taban_CLI="@BIN_TABAN@ client --server @SRV@ --transport kama-product --msgs 168 --payload 37 --submit-interval-ms 120 --warmup-msgs 16 --max-deadline-s 6 --fec-profile 2 --fec-mode adaptive --profile cx_r12k_d300_l20_b120 --repeat @REP@ --ts-out @D@/ts.csv --manifest @D@/manifest.json --fwd-impair '$FWD' --rev-impair '$REV' --out @D@/out.jsonl"
ARM_pol_taban_SRV="@BIN_TABAN@ serve --bind @SRV@ --transport kama-product --payload 37 --fec-mode policy --fec-deadline-ms 680 --rx-log @D@/rx.jsonl"
ARM_pol_taban_CLI="@BIN_TABAN@ client --server @SRV@ --transport kama-product --msgs 168 --payload 37 --submit-interval-ms 120 --warmup-msgs 16 --max-deadline-s 6 --fec-mode policy --fec-deadline-ms 680 --profile cx_r12k_d300_l20_b120 --repeat @REP@ --ts-out @D@/ts.csv --manifest @D@/manifest.json --fwd-impair '$FWD' --rev-impair '$REV' --out @D@/out.jsonl"
ARM_uyar_taban_SRV="@BIN_TABAN@ serve --bind @SRV@ --transport kama-product --payload 37 --rx-log @D@/rx.jsonl"
ARM_uyar_taban_CLI="@BIN_TABAN@ client --server @SRV@ --transport kama-product --msgs 168 --payload 37 --submit-interval-ms 120 --warmup-msgs 16 --max-deadline-s 6 --profile cx_r12k_d300_l20_b120 --repeat @REP@ --ts-out @D@/ts.csv --manifest @D@/manifest.json --fwd-impair '$FWD' --rev-impair '$REV' --out @D@/out.jsonl"
