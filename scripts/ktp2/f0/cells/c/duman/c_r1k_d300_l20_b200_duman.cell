# [KTP2-F0 · Ajan C] ÜRETİLDİ — scripts/ktp2/f0/c/gen_cells.py (elle düzenlemeyin).
# öncelik=0  demet=200 ms  kayıp=%20  gecikme=d300  hız=r1k  payload=49 B  çerçeve=104  ısınma=16
# rs2 r=1, rs4 r=1
# tahmini süre: 10 kol × 1 tekrar × ~30 s = 0.08 koşu-saati
# rx-log: AÇIK (İSTEK-C1)
CELL=c_r1k_d300_l20_b200_duman
FWD="delay 300ms 60ms distribution normal loss 20% rate 8kbit"
REV="$FWD"
REPS=1
ARMS="arq_taban arq_aday uyar_taban uyar_aday rs2_taban rs2_aday rs4_taban rs4_aday tekrar_taban tekrar_aday"
BUDGET_S=120
CAPTURE=0
SETTLE_S=1
ARM_arq_taban_SRV="@BIN_TABAN@ serve --bind @SRV@ --transport kama-product --payload 49 --fec-profile 0 --rx-log @D@/rx.jsonl"
ARM_arq_taban_CLI="@BIN_TABAN@ client --server @SRV@ --transport kama-product --msgs 104 --payload 49 --submit-interval-ms 200 --warmup-msgs 16 --max-deadline-s 6 --fec-profile 0 --profile c_r1k_d300_l20_b200_duman --repeat @REP@ --ts-out @D@/ts.csv --manifest @D@/manifest.json --fwd-impair '$FWD' --rev-impair '$REV' --out @D@/out.jsonl"
ARM_arq_aday_SRV="@BIN_ADAY@ serve --bind @SRV@ --transport kama-product --payload 49 --fec-profile 0 --rx-log @D@/rx.jsonl"
ARM_arq_aday_CLI="@BIN_ADAY@ client --server @SRV@ --transport kama-product --msgs 104 --payload 49 --submit-interval-ms 200 --warmup-msgs 16 --max-deadline-s 6 --fec-profile 0 --profile c_r1k_d300_l20_b200_duman --repeat @REP@ --ts-out @D@/ts.csv --manifest @D@/manifest.json --fwd-impair '$FWD' --rev-impair '$REV' --out @D@/out.jsonl"
