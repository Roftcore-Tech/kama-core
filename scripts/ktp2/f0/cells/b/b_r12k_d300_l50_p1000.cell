DELAY_ID=d300
LOSS_PCT=50
RATE_BPS=12500
DELAY_MS=300
JITTER_MS=60
MSGS=100
PAY=1000
IVAL_MS=285
DEADLINE_S=60
FWD="delay 300ms 60ms distribution normal loss 50% rate 100kbit"
REV="$FWD"
REPS="${F0_REPS:-10}"
ARMS="taban aday quinn tcp"
BUDGET_S=185
CAPTURE=0
SETTLE_S=1.5
