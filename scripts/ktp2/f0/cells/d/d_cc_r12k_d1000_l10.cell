# [KTP2-F0 / Ajan D] KAYIPTA HIZ: quinn BBR ↔ quinn Cubic ↔ tcp (çekirdek cubic) ↔ Kama, 12,5 kB/s
# (betimsel, N=10). Yük 1000 B × 150, 200 ms aralık (≈ %41 hat yükü; kayıpla gereken ≈ 1/(1−p) kat
# hâlâ hattın altında). Cubic'in asgari penceresi 2 × 1452 B: RTT 0,6 s'de ≈ 4,8 kB/s, RTT 2 s'de
# ≈ 1,45 kB/s — sunulan 5 kB/s'nin altına düşerse kuyruk büyür (öngörü). Pencere 60 s.
CELL=d_cc_r12k_d1000_l10
FWD="delay 1000ms 200ms distribution normal loss 10% rate 100kbit"
REV="$FWD"
REPS="${F0_REPS:-10}"
BUDGET_S=180
PAY=1000; MSGS=150; IVAL_MS=200; DEADLINE_S=60; HS_TIMEOUT_S=60
# shellcheck disable=SC1091
source "$(dirname "${BASH_SOURCE[0]}")/../../arms_rakip.sh"
rakip_arms
# Kama kolu (taban): arms_kama.sh `kama_arm_cmds` ile aynı iş yükü; sunucu alıcı damgası da yazar.
ARM_taban_SRV="@BIN_TABAN@ serve --bind @SRV@ --transport kama-product --payload $PAY --rx-log @D@/rx_log.jsonl"
ARM_taban_CLI="@BIN_TABAN@ client --server @SRV@ --transport kama-product $RAKIP_LOAD_ARGS"
ARMS="taban quinn quinn_cubic tcp"
