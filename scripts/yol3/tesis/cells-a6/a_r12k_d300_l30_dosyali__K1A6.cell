# Şeritsiz (--goster yok): tek sıralı kuyruk, oynatma tamponu yok; oku_a6.py ilk duyulabilir sesi yalnız s-kollarında yazar.
CELL=a_r12k_d300_l30_dosyali__K1A6
FWD="delay 300ms 60ms distribution normal loss 30% rate 100kbit"
